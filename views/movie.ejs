<!DOCTYPE html>
<html lang="bn" data-theme="dark">
<head>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-YFCKZB39ES"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-YFCKZB39ES');
  </script>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="<%= data.hadding %>">
  <meta name="robots" content="index, follow">
  <meta name="keywords" content="<%= keywords %>" />
  <meta name="theme-color" content="#07080d">

  <link rel="preload" as="image" href="<%= data.img %>" fetchpriority="high">

  <title><%= data.hadding %> - <%= movieName %></title>
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="icon" type="image/png" sizes="128x128" href="/favicon.png">
  <link rel="canonical" href="<%= url %>/movie/<%= data.id %>" />

  <!-- Preconnects -->
  <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
  <link rel="preconnect" href="https://i.postimg.cc">
  <!-- OG TAG -->
  <meta property="og:title" content="<%= data.hadding %>">
  <meta property="og:description" content="<%= description %>">
  <meta property="og:image" content="<%= data.img %>">
  <meta property="og:url" content="<%= url %>/movie/<%= data.id %>">
  <meta property="og:type" content="video.other">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="player">
  <meta name="twitter:title" content="<%= data.hadding %>">
  <meta name="twitter:description" content="<%= description %>">
  <meta name="twitter:image" content="<%= data.img %>">

  <!-- Font Awesome (non-blocking) -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css"></noscript>

  <!-- Prevent theme flash -->
  <script>
    document.documentElement.setAttribute('data-theme', localStorage.getItem('desi-theme') || 'dark');
  </script>

  <style>
    /* ====== Base ====== */
    * { margin: 0; padding: 0; box-sizing: border-box; }

    html, body {
      max-width: 100%;
      overflow-x: hidden;
    }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      min-height: 100vh;
      transition: background 0.35s, color 0.35s;
    }

    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background:
        radial-gradient(circle at 20% 30%, rgba(77, 163, 255, 0.06) 0%, transparent 50%),
        radial-gradient(circle at 80% 70%, rgba(255, 77, 164, 0.05) 0%, transparent 50%),
        radial-gradient(circle at 40% 80%, rgba(255, 184, 77, 0.05) 0%, transparent 50%);
      z-index: -1;
      pointer-events: none;
    }

    .wrap {
      max-width: 1100px;
      margin: 0 auto;
      padding: 30px 20px;
      position: relative;
    }

    /* ====== Movie title ====== */
    h1 {
      font-size: 27px;
      margin-bottom: 20px;
      color: var(--text);
      font-weight: 800;
      position: relative;
      padding-bottom: 12px;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    h1 i {
      color: var(--accent);
      font-size: 24px;
    }

    h1::after {
      content: '';
      position: absolute;
      bottom: 0; left: 0;
      width: 110px;
      height: 4px;
      background: var(--gradient);
      border-radius: 2px;
    }

    /* ====== Video player ====== */
    .video-player-container {
      position: relative;
      width: 100%;
      border-radius: 18px;
      overflow: hidden;
      background: #000;
      box-shadow: 0 18px 45px var(--shadow), 0 0 30px rgba(77, 163, 255, 0.18);
      border: 2px solid var(--border);
      transition: box-shadow 0.4s, border-color 0.4s;
    }

    .video-player-container:hover {
      box-shadow: 0 22px 55px var(--shadow), 0 0 40px rgba(77, 163, 255, 0.35);
      border-color: var(--accent);
    }

    .video-frame {
      position: relative;
      width: 100%;
      background: #000;
    }

    video {
      width: 100%;
      height: auto;
      display: block;
      cursor: pointer;
      background: #000;
    }

    .video-loading {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      background: rgba(0, 0, 0, 0.3);
      pointer-events: none;
    }

    .video-loading[hidden] { display: none; }

    .video-loading-spinner {
      width: 52px;
      height: 52px;
      border: 5px solid rgba(255, 255, 255, 0.35);
      border-top-color: var(--accent);
      border-radius: 50%;
      animation: video-loading-spin 0.8s linear infinite;
    }

    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    @keyframes video-loading-spin {
      to { transform: rotate(360deg); }
    }

    /* Description banner */
    .description {
      text-align: center;
      background: linear-gradient(90deg, #ff8f00, #ffc107);
    }

    .description p {
      background: transparent;
      color: #1a1a1a;
      font-weight: 600;
      padding: 10px;
      text-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
    }

    /* ====== Buttons ====== */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      margin-top: 20px;
      padding: 16px 32px;
      background: linear-gradient(135deg, #e50914 0%, #b50710 100%);
      color: #fff;
      text-decoration: none;
      border-radius: 14px;
      font-weight: 700;
      font-size: 16px;
      transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.3s, filter 0.3s;
      box-shadow: 0 8px 22px rgba(229, 9, 20, 0.35);
      border: none;
      cursor: pointer;
      position: relative;
      overflow: hidden;
    }

    .btn::before {
      content: '';
      position: absolute;
      top: 0; left: -100%;
      width: 100%; height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
      transition: left 0.7s;
    }

    .btn:hover {
      filter: brightness(1.1);
      transform: translateY(-5px);
      box-shadow: 0 16px 32px rgba(229, 9, 20, 0.5);
    }

    .btn:hover::before { left: 100%; }
    .btn:active { transform: translateY(-2px); }

    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      align-items: center;
    }

    .btn-tw {
      background: linear-gradient(135deg, #0e7d34, #0a5424);
      box-shadow: 0 8px 22px rgba(14, 125, 52, 0.35);
    }
    .btn-tg {
      background: linear-gradient(135deg, #1b76b5, #14599a);
      box-shadow: 0 8px 22px rgba(27, 118, 181, 0.35);
    }

    /* ====== Divider ====== */
    hr {
      margin: 40px 0;
      border: 0;
      border-top: 2px solid;
      border-image: linear-gradient(90deg, transparent, var(--accent), var(--accent-2), transparent) 1;
    }

    /* ====== Suggested heading ====== */
    .section-title {
      font-size: 23px;
      margin-bottom: 22px;
      font-weight: 800;
      color: var(--text);
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .section-title i { color: var(--accent); }

    /* ====== Suggested grid ====== */
    .suggest-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, 300px);
      justify-content: center;
      gap: 20px;
      margin-bottom: 30px;
    }

    .suggest-wrap { max-width: none; }

    .s-card {
      text-decoration: none;
      color: var(--text);
      background: var(--card-grad);
      border-radius: 14px;
      overflow: hidden;
      transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.4s;
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
      position: relative;
      display: flex;
      flex-direction: column;
    }

    .s-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0;
      width: 100%; height: 100%;
      background: linear-gradient(135deg, rgba(77, 163, 255, 0.12) 0%, rgba(255, 77, 164, 0.12) 100%);
      opacity: 0;
      transition: opacity 0.4s;
      z-index: 1;
      pointer-events: none;
    }

    .s-card::after {
      content: '';
      position: absolute;
      bottom: 0; left: 0;
      width: 100%; height: 4px;
      background: var(--gradient);
      transform: scaleX(0);
      transition: transform 0.4s;
      z-index: 2;
    }

    .s-card img {
      width: 100%;
      height: auto;
      display: block;
      transition: filter 0.6s;
      filter: brightness(0.92);
      border-bottom: 1px solid var(--border);
    }

    .s-card p {
      font-size: 15px;
      padding: 15px;
      margin: 0;
      font-weight: 600;
      line-height: 1.4;
      flex-grow: 1;
      display: flex;
      align-items: center;
      z-index: 2;
      position: relative;
    }

    .s-card:hover {
      transform: translateY(-10px);
      box-shadow: 0 22px 42px var(--shadow), 0 0 30px rgba(77, 163, 255, 0.25);
      border-color: var(--accent);
    }

    .s-card:hover::before { opacity: 1; }
    .s-card:hover::after { transform: scaleX(1); }
    .s-card:hover img { filter: brightness(1.1); }
    .s-card:hover p { color: var(--accent); }

    /* Rating badge */
    .s-card .rating {
      position: absolute;
      top: 13px;
      right: 13px;
      background: linear-gradient(135deg, #c2185b, #8e1045);
      color: #fff;
      font-weight: 800;
      font-size: 13px;
      padding: 5px 10px;
      border-radius: 9px;
      z-index: 3;
      box-shadow: 0 5px 12px rgba(0, 0, 0, 0.45);
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .s-card .rating i { color: gold; font-size: 11px; }

    .smart-link-overlay {
      position: fixed;
      inset: 0;
      z-index: 2000;
      display: grid;
      place-items: center;
      width: 100%;
      height: 100%;
      padding: 16px;
      background: rgba(0, 0, 0, 0.72);
    }

    .smart-link-overlay[hidden] { display: none; }

    .smart-link-dialog {
      width: min(440px, 100%);
      max-height: min(90vh, 90dvh);
      overflow: auto;
      border: 1px solid var(--border);
      border-radius: 20px;
      color: var(--text);
      background: var(--surface);
      box-shadow: 0 24px 70px rgba(0, 0, 0, 0.6);
      padding: clamp(22px, 5vw, 32px);
      text-align: center;
    }

    .smart-link-icon {
      display: grid;
      place-items: center;
      width: 56px;
      height: 56px;
      margin: 0 auto 16px;
      border-radius: 18px;
      color: #fff;
      background: var(--gradient);
      box-shadow: 0 8px 24px rgba(77, 163, 255, 0.25);
      font-size: 23px;
    }

    .smart-link-dialog h2 { margin-bottom: 12px; font-size: 21px; }
    .smart-link-dialog p { line-height: 1.6; color: var(--text-2); }
    .smart-link-actions { display: flex; justify-content: center; gap: 12px; margin-top: 22px; }
    .smart-link-actions .btn { margin-top: 0; }
    .smart-link-actions .btn:disabled { opacity: 0.65; cursor: wait; }
    .btn-secondary { background: var(--surface-2); box-shadow: none; }

    /* Load more */
    .load-btn {
      width: 100%;
      margin: 30px 0 50px;
      padding: 18px;
      background: linear-gradient(135deg, #1a6bff 0%, #123a8f 100%);
      border: none;
      color: #fff;
      font-size: 16px;
      font-weight: 700;
      border-radius: 14px;
      cursor: pointer;
      transition: transform 0.3s, box-shadow 0.3s, filter 0.3s;
      box-shadow: 0 10px 26px rgba(26, 107, 255, 0.3);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      position: relative;
      overflow: hidden;
    }

    .load-btn::before {
      content: '';
      position: absolute;
      top: 0; left: -100%;
      width: 100%; height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.25), transparent);
      transition: left 0.7s;
    }

    .load-btn:hover { filter: brightness(1.1); transform: translateY(-5px); box-shadow: 0 16px 34px rgba(26, 107, 255, 0.5); }
    .load-btn:hover::before { left: 100%; }
    .load-btn:disabled { opacity: 0.7; cursor: not-allowed; transform: none !important; }

    /* Other website */
    .otherWebsite {
      text-align: center;
      padding: 10px 0 40px;
    }

    .otherWebsite .btn {
      margin: 10px 8px 0;
    }

    /* ====== Responsive ====== */
    @media (max-width: 1024px) {
      .wrap { max-width: 95%; padding: 20px 15px; }
      .suggest-grid { gap: 18px; }
      h1 { font-size: 24px; }
    }

    @media (max-width: 768px) {
      .suggest-grid { grid-template-columns: 300px; gap: 12px; }
      .suggest-wrap { padding-left: 10px; padding-right: 10px; }
      .s-card p { font-size: 14px; padding: 12px; }
      h1 { font-size: 22px; }
      .section-title { font-size: 20px; }
      .btn, .load-btn { padding: 14px 28px; font-size: 15px; }
    }

    @media (max-width: 480px) {
      .suggest-grid { grid-template-columns: 300px; gap: 10px; }
      .s-card p { font-size: 13px; padding: 10px; }
      h1 { font-size: 20px; }
      .section-title { font-size: 18px; }
      .btn, .load-btn { padding: 12px 24px; font-size: 14px; width: 100%; text-align: center; }
      .smart-link-actions .btn { width: auto; flex: 1; }
    }
  </style>
</head>
<body>
<%- include('partials/nav') %>
<%- include('partials/header') %>

<div class="wrap">
  <h1><i class="fa-solid fa-video" aria-hidden="true"></i> <%= data.hadding %></h1>

  <!-- Video Player -->
  <div class="video-player-container">
    <div class="video-frame">
      <video
        id="mainVideo"
        controls
        preload="auto"
        playsinline
        poster="<%= data.img %>"
        aria-label="<%= data.hadding %>"
        tabindex="0"
        data-playing="false"
        data-video-id="<%= data.id %>"
        data-page-path="/movie/<%= encodeURIComponent(data.id) %>"
        data-smart-link-available="<%= smartLink ? 'true' : 'false' %>"
        data-consented="<%= smartLinkFlowCompleted ? 'true' : 'false' %>">
        <source src="<%= data.play %>" type="video/mp4">
        Your browser does not support the video tag.
      </video>
      <div id="videoLoading" class="video-loading" role="status" aria-live="polite">
        <span class="video-loading-spinner" aria-hidden="true"></span>
        <span class="visually-hidden">Loading video</span>
      </div>
    </div>
    <div class="description">
      <p><i class="fa-solid fa-circle-info" aria-hidden="true"></i> <%= description %></p>
    </div>
  </div>

  <div class="actions">
    <a class="btn" href="<%= downloadLink %>" target="_blank" rel="noopener noreferrer">
      <i class="fa-solid fa-download" aria-hidden="true"></i> Download Video
    </a>
  </div>

</div>

<div id="smartLinkModal" class="smart-link-overlay" role="dialog" aria-modal="true" aria-labelledby="smartLinkTitle" aria-describedby="smartLinkDescription" hidden>
  <section class="smart-link-dialog">
    <div class="smart-link-icon" aria-hidden="true"><i class="fa-solid fa-arrow-up-right-from-square"></i></div>
    <h2 id="smartLinkTitle">Continue to the video link?</h2>
    <p id="smartLinkDescription">Continue চাপলে আপনি নির্ধারিত link-এ যাবেন। ফিরে এলে ভিডিও সরাসরি চালু হবে।</p>
    <div class="smart-link-actions">
      <button type="button" id="smartLinkCancel" class="btn btn-secondary">Cancel</button>
      <button type="button" id="smartLinkContinue" class="btn">Continue</button>
    </div>
  </section>
</div>

<hr style="margin:20px 0;border:0;border-top:1px solid var(--border)">

<div class="wrap suggest-wrap">
  <h2 class="section-title"><i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i> Suggested Videos</h2>

  <div
    class="suggest-grid"
    id="suggestGrid"
    data-skip="<%= suggested.length %>"
    data-has-more="<%= hasMoreSuggested %>">
    <% suggested.forEach(item => { %>
      <a href="/movie/<%= item.id %>" class="s-card">
        <div class="rating"><i class="fa-solid fa-star" aria-hidden="true"></i><%= (Math.random() * 2 + 8).toFixed(1) %></div>
        <img src="<%= item.img %>" loading="lazy" decoding="async" alt="<%= item.hadding %>">
        <p><%= item.hadding %></p>
      </a>
    <% }) %>
  </div>

  <button id="loadMore" class="load-btn" type="button" <%= hasMoreSuggested ? '' : 'hidden' %>>
    <span>See More</span>
    <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
  </button>
  <p id="suggestedLoadStatus" role="status" aria-live="polite"></p>

  <div class="otherWebsite">
    <h2 class="section-title" style="justify-content:center"><i class="fa-solid fa-globe" aria-hidden="true"></i> Other Website</h2>
    <a href="<%= moreWebsite %>" class="btn btn-tw"><i class="fa-solid fa-globe" aria-hidden="true"></i> P9X9.COM</a>
    <a href="<%= telegramLink %>" class="btn btn-tg"><i class="fa-brands fa-telegram" aria-hidden="true"></i> Telegram</a>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  var video = document.getElementById('mainVideo');
  var videoLoading = document.getElementById('videoLoading');
  var modal = document.getElementById('smartLinkModal');
  var continueButton = document.getElementById('smartLinkContinue');
  var cancelButton = document.getElementById('smartLinkCancel');
  var lastFocusedElement = null;
  var consentPending = false;
  var consentRequest = null;
  var resumeOnReturn = false;

  function setVideoLoading(loading) {
    videoLoading.hidden = !loading;
  }

  video.addEventListener('loadstart', function() { setVideoLoading(true); });
  video.addEventListener('waiting', function() { setVideoLoading(true); });
  video.addEventListener('stalled', function() { setVideoLoading(true); });
  video.addEventListener('canplay', function() { setVideoLoading(false); });
  video.addEventListener('playing', function() { setVideoLoading(false); });
  video.addEventListener('error', function() { setVideoLoading(false); });

  video.preload = 'auto';
  video.load();

  function playVideo() {
    video.play().catch(function(error) {
      console.error('Unable to play video:', error);
    });
  }

  function openConsentDialog() {
    if (consentPending || !modal.hidden) return;
    lastFocusedElement = document.activeElement;
    modal.hidden = false;
    continueButton.focus();
  }

  function closeConsentDialog() {
    modal.hidden = true;
    if (consentRequest) consentRequest.abort();
    if (lastFocusedElement && document.contains(lastFocusedElement)) {
      lastFocusedElement.focus();
    } else {
      video.focus();
    }
  }

  video.addEventListener('play', function(event) {
    if (video.dataset.consented === 'true' || video.dataset.smartLinkAvailable !== 'true') return;
    video.pause();
    openConsentDialog();
  });

  window.addEventListener('blur', function() {
    if (video.dataset.consented === 'true') resumeOnReturn = true;
  });

  window.addEventListener('focus', function() {
    if (!resumeOnReturn || video.dataset.consented !== 'true') return;
    resumeOnReturn = false;
    playVideo();
  });

  cancelButton.addEventListener('click', function() {
    closeConsentDialog();
  });

  document.addEventListener('keydown', function(event) {
    if (modal.hidden) return;
    if (event.key === 'Escape') {
      event.preventDefault();
      closeConsentDialog();
      return;
    }
    if (event.key !== 'Tab') return;

    event.preventDefault();
    (document.activeElement === continueButton ? cancelButton : continueButton).focus();
  });

  modal.addEventListener('click', function(event) {
    if (event.target === modal) closeConsentDialog();
  });

  continueButton.addEventListener('click', async function() {
    if (consentPending) return;
    consentPending = true;
    continueButton.disabled = true;
    consentRequest = new AbortController();
    var smartLinkTab = window.open('about:blank', '_blank');

    try {
      if (!smartLinkTab) throw new Error('The browser blocked opening a new tab');
      smartLinkTab.opener = null;

      var response = await fetch('/api/movies/' + encodeURIComponent(video.dataset.videoId) + '/smart-link', {
        method: 'POST',
        headers: { 'Accept': 'application/json' },
        signal: consentRequest.signal
      });
      if (!response.ok) throw new Error('Smart link request failed: ' + response.status);

      var result = await response.json();
      if (!result.redirectUrl) {
        smartLinkTab.close();
        closeConsentDialog();
        video.dataset.consented = 'true';
        playVideo();
        return;
      }

      var redirectUrl = new URL(result.redirectUrl);
      if (redirectUrl.protocol !== 'https:' && redirectUrl.protocol !== 'http:') {
        throw new Error('Smart link must use HTTP or HTTPS');
      }
      video.dataset.consented = 'true';
      resumeOnReturn = true;
      await new Promise(function(resolve) {
        window.setTimeout(resolve, 1000);
      });
      if (!smartLinkTab.closed) smartLinkTab.location.replace(redirectUrl.href);
      closeConsentDialog();
    } catch (error) {
      if (smartLinkTab && !smartLinkTab.closed) smartLinkTab.close();
      if (error.name === 'AbortError') return;
      console.error('Unable to continue to smart link:', error);
      closeConsentDialog();
      video.dataset.consented = 'true';
      playVideo();
    } finally {
      consentRequest = null;
      consentPending = false;
      continueButton.disabled = false;
    }
  });

  video.addEventListener('play', function() {
    video.setAttribute('data-playing', 'true');
  });

  video.addEventListener('pause', function() {
    video.setAttribute('data-playing', 'false');
  });

  video.addEventListener('ended', function() {
    video.setAttribute('data-playing', 'false');
  });
});

// ===== Infinite scroll suggestions =====
var grid = document.getElementById("suggestGrid");
var btn = document.getElementById("loadMore");
var status = document.getElementById("suggestedLoadStatus");
var skip = Number(grid.dataset.skip);
var excludeId = <%- JSON.stringify(data.id) %>;
var hasMoreSuggested = grid.dataset.hasMore === 'true';
var isLoadingSuggested = false;
var suggestedObserver;

function appendSuggested(item) {
  var a = document.createElement("a");
  a.href = '/movie/' + encodeURIComponent(item.id);
  a.className = 's-card';

  var rating = document.createElement('div');
  rating.className = 'rating';
  rating.innerHTML = '<i class="fa-solid fa-star" aria-hidden="true"></i>' + (Math.random() * 2 + 8).toFixed(1);

  var image = document.createElement('img');
  image.src = item.img;
  image.loading = 'lazy';
  image.decoding = 'async';
  image.alt = item.hadding;

  var title = document.createElement('p');
  title.textContent = item.hadding;
  a.append(rating, image, title);
  grid.appendChild(a);
}

async function loadMoreSuggested() {
  if (isLoadingSuggested || !hasMoreSuggested) return;
  isLoadingSuggested = true;
  btn.disabled = true;
  btn.innerHTML = '<span>Loading...</span><i class="fa-solid fa-spinner fa-spin" aria-hidden="true"></i>';
  status.textContent = '';

  try {
    var params = new URLSearchParams({ excludeId: excludeId, skip: String(skip) });
    var res = await fetch('/api/suggested?' + params.toString());
    if (!res.ok) throw new Error('Suggested videos request failed: ' + res.status);
    var result = await res.json();

    result.movies.forEach(appendSuggested);
    skip += result.movies.length;
    hasMoreSuggested = result.hasMore;
    grid.dataset.skip = String(skip);
    grid.dataset.hasMore = String(hasMoreSuggested);
    btn.hidden = !hasMoreSuggested;
    btn.innerHTML = '<span>See More</span><i class="fa-solid fa-chevron-down"></i>';
  } catch (error) {
    console.error("Error loading suggestions:", error);
    btn.innerHTML = '<span>Error loading. Try again</span>';
    status.textContent = 'Suggested videos could not be loaded. Please try again.';
    if (suggestedObserver) suggestedObserver.unobserve(btn);
  } finally {
    isLoadingSuggested = false;
    btn.disabled = false;
  }
}

btn.addEventListener('click', loadMoreSuggested);
if ('IntersectionObserver' in window && hasMoreSuggested) {
  suggestedObserver = new IntersectionObserver(function(entries) {
    if (entries.some(function(entry) { return entry.isIntersecting; })) loadMoreSuggested();
  }, { rootMargin: '600px 0px' });
  suggestedObserver.observe(btn);
}
</script>

<% if (socialBarScriptUrl) { %>
<script data-cfasync="false" src="<%= socialBarScriptUrl %>"></script>
<% } %>
</body>
</html>