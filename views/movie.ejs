<!DOCTYPE html>
<html lang="bn" data-theme="dark">
<head>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-YFCKZB39ES"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-YFCKZB39ES');
  </script>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="<%= data.hadding %>">
  <meta name="robots" content="index, follow">
  <meta name="keywords" content="<%= keywords %>" />
  <meta name="theme-color" content="#07080d">

  <link rel="preload" as="image" href="<%= data.img %>" fetchpriority="high">

  <title><%= data.hadding %> - <%= movieName %></title>
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="icon" type="image/png" sizes="128x128" href="/favicon.png">
  <link rel="canonical" href="<%= url %>/movie/<%= data.id %>" />

  <!-- Preconnects -->
  <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
  <link rel="preconnect" href="https://i.postimg.cc">
  <link rel="preconnect" href="https://welcomingexpulsion.com">

  <!-- OG TAG -->
  <meta property="og:title" content="<%= data.hadding %>">
  <meta property="og:description" content="<%= description %>">
  <meta property="og:image" content="<%= data.img %>">
  <meta property="og:url" content="<%= url %>/movie/<%= data.id %>">
  <meta property="og:type" content="video.other">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="player">
  <meta name="twitter:title" content="<%= data.hadding %>">
  <meta name="twitter:description" content="<%= description %>">
  <meta name="twitter:image" content="<%= data.img %>">

  <!-- Font Awesome (non-blocking) -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css"></noscript>

  <!-- Prevent theme flash -->
  <script>
    document.documentElement.setAttribute('data-theme', localStorage.getItem('desi-theme') || 'dark');
  </script>

  <style>
    /* ====== Base ====== */
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      min-height: 100vh;
      overflow-x: clip;
      transition: background 0.35s, color 0.35s;
    }

    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background:
        radial-gradient(circle at 20% 30%, rgba(77, 163, 255, 0.06) 0%, transparent 50%),
        radial-gradient(circle at 80% 70%, rgba(255, 77, 164, 0.05) 0%, transparent 50%),
        radial-gradient(circle at 40% 80%, rgba(255, 184, 77, 0.05) 0%, transparent 50%);
      z-index: -1;
      pointer-events: none;
    }

    .wrap {
      max-width: 1100px;
      margin: 0 auto;
      padding: 30px 20px;
      position: relative;
    }

    /* ====== Movie title ====== */
    h1 {
      font-size: 27px;
      margin-bottom: 20px;
      color: var(--text);
      font-weight: 800;
      position: relative;
      padding-bottom: 12px;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    h1 i {
      color: var(--accent);
      font-size: 24px;
    }

    h1::after {
      content: '';
      position: absolute;
      bottom: 0; left: 0;
      width: 110px;
      height: 4px;
      background: var(--gradient);
      border-radius: 2px;
    }

    /* ====== Video player ====== */
    .video-player-container {
      position: relative;
      width: 100%;
      border-radius: 18px;
      overflow: hidden;
      background: #000;
      box-shadow: 0 18px 45px var(--shadow), 0 0 30px rgba(77, 163, 255, 0.18);
      border: 2px solid var(--border);
      transition: box-shadow 0.4s, border-color 0.4s;
    }

    .video-player-container:hover {
      box-shadow: 0 22px 55px var(--shadow), 0 0 40px rgba(77, 163, 255, 0.35);
      border-color: var(--accent);
    }

    video {
      width: 100%;
      height: auto;
      display: block;
      cursor: pointer;
      background: #000;
    }

    /* Center play/pause button */
    .center-play-button {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 80px;
      height: 80px;
      background: rgba(0, 0, 0, 0.65);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      opacity: 0;
      transition: all 0.3s ease;
      z-index: 10;
      border: 3px solid rgba(255, 255, 255, 0.85);
      box-shadow: 0 0 30px rgba(0, 0, 0, 0.8);
    }

    .center-play-button:hover {
      background: rgba(0, 0, 0, 0.9);
      border-color: var(--accent);
      transform: translate(-50%, -50%) scale(1.1);
    }

    .center-play-button i {
      font-size: 34px;
      color: #fff;
      margin-left: 5px;
      text-shadow: 0 2px 10px rgba(0, 0, 0, 0.7);
    }

    .video-player-container:hover .center-play-button,
    video:not([data-playing="true"]) + .center-play-button { opacity: 1; }
    video[data-playing="true"] + .center-play-button { opacity: 0; }
    .video-player-container:hover video[data-playing="true"] + .center-play-button { opacity: 1; }

    /* Description banner */
    .description {
      text-align: center;
      background: linear-gradient(90deg, #ff8f00, #ffc107);
    }

    .description p {
      background: transparent;
      color: #1a1a1a;
      font-weight: 600;
      padding: 10px;
      text-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
    }

    /* ====== Buttons ====== */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      margin-top: 20px;
      padding: 16px 32px;
      background: linear-gradient(135deg, #e50914 0%, #b50710 100%);
      color: #fff;
      text-decoration: none;
      border-radius: 14px;
      font-weight: 700;
      font-size: 16px;
      transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.3s, filter 0.3s;
      box-shadow: 0 8px 22px rgba(229, 9, 20, 0.35);
      border: none;
      cursor: pointer;
      position: relative;
      overflow: hidden;
    }

    .btn::before {
      content: '';
      position: absolute;
      top: 0; left: -100%;
      width: 100%; height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
      transition: left 0.7s;
    }

    .btn:hover {
      filter: brightness(1.1);
      transform: translateY(-5px);
      box-shadow: 0 16px 32px rgba(229, 9, 20, 0.5);
    }

    .btn:hover::before { left: 100%; }
    .btn:active { transform: translateY(-2px); }

    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      align-items: center;
    }

    .btn-tw {
      background: linear-gradient(135deg, #0e7d34, #0a5424);
      box-shadow: 0 8px 22px rgba(14, 125, 52, 0.35);
    }
    .btn-tg {
      background: linear-gradient(135deg, #1b76b5, #14599a);
      box-shadow: 0 8px 22px rgba(27, 118, 181, 0.35);
    }

    /* ====== Divider ====== */
    hr {
      margin: 40px 0;
      border: 0;
      border-top: 2px solid;
      border-image: linear-gradient(90deg, transparent, var(--accent), var(--accent-2), transparent) 1;
    }

    /* ====== Suggested heading ====== */
    .section-title {
      font-size: 23px;
      margin-bottom: 22px;
      font-weight: 800;
      color: var(--text);
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .section-title i { color: var(--accent); }

    /* ====== Suggested grid ====== */
    .suggest-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 20px;
      margin-bottom: 30px;
    }

    .s-card {
      text-decoration: none;
      color: var(--text);
      background: var(--card-grad);
      border-radius: 14px;
      overflow: hidden;
      transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.4s;
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
      position: relative;
      display: flex;
      flex-direction: column;
    }

    .s-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0;
      width: 100%; height: 100%;
      background: linear-gradient(135deg, rgba(77, 163, 255, 0.12) 0%, rgba(255, 77, 164, 0.12) 100%);
      opacity: 0;
      transition: opacity 0.4s;
      z-index: 1;
      pointer-events: none;
    }

    .s-card::after {
      content: '';
      position: absolute;
      bottom: 0; left: 0;
      width: 100%; height: 4px;
      background: var(--gradient);
      transform: scaleX(0);
      transition: transform 0.4s;
      z-index: 2;
    }

    .s-card img {
      width: 100%;
      height: 220px;
      object-fit: cover;
      display: block;
      transition: transform 0.6s, filter 0.6s;
      filter: brightness(0.92);
      border-bottom: 1px solid var(--border);
    }

    .s-card p {
      font-size: 15px;
      padding: 15px;
      margin: 0;
      font-weight: 600;
      line-height: 1.4;
      flex-grow: 1;
      display: flex;
      align-items: center;
      z-index: 2;
      position: relative;
    }

    .s-card:hover {
      transform: translateY(-10px) scale(1.03);
      box-shadow: 0 22px 42px var(--shadow), 0 0 30px rgba(77, 163, 255, 0.25);
      border-color: var(--accent);
    }

    .s-card:hover::before { opacity: 1; }
    .s-card:hover::after { transform: scaleX(1); }
    .s-card:hover img { transform: scale(1.08); filter: brightness(1.1); }
    .s-card:hover p { color: var(--accent); }

    /* Rating badge */
    .s-card .rating {
      position: absolute;
      top: 13px;
      right: 13px;
      background: linear-gradient(135deg, #c2185b, #8e1045);
      color: #fff;
      font-weight: 800;
      font-size: 13px;
      padding: 5px 10px;
      border-radius: 9px;
      z-index: 3;
      box-shadow: 0 5px 12px rgba(0, 0, 0, 0.45);
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .s-card .rating i { color: gold; font-size: 11px; }

    /* Load more */
    .load-btn {
      width: 100%;
      margin: 30px 0 50px;
      padding: 18px;
      background: linear-gradient(135deg, #1a6bff 0%, #123a8f 100%);
      border: none;
      color: #fff;
      font-size: 16px;
      font-weight: 700;
      border-radius: 14px;
      cursor: pointer;
      transition: transform 0.3s, box-shadow 0.3s, filter 0.3s;
      box-shadow: 0 10px 26px rgba(26, 107, 255, 0.3);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      position: relative;
      overflow: hidden;
    }

    .load-btn::before {
      content: '';
      position: absolute;
      top: 0; left: -100%;
      width: 100%; height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.25), transparent);
      transition: left 0.7s;
    }

    .load-btn:hover { filter: brightness(1.1); transform: translateY(-5px); box-shadow: 0 16px 34px rgba(26, 107, 255, 0.5); }
    .load-btn:hover::before { left: 100%; }
    .load-btn:disabled { opacity: 0.7; cursor: not-allowed; transform: none !important; }

    /* Other website */
    .otherWebsite {
      text-align: center;
      padding: 10px 0 40px;
    }

    .otherWebsite .btn {
      margin: 10px 8px 0;
    }

    /* ====== Responsive ====== */
    @media (max-width: 1024px) {
      .wrap { max-width: 95%; padding: 20px 15px; }
      .suggest-grid { grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 18px; }
      .s-card img { height: 200px; }
      h1 { font-size: 24px; }
      .center-play-button { width: 70px; height: 70px; }
      .center-play-button i { font-size: 30px; }
    }

    @media (max-width: 768px) {
      .suggest-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
      .s-card img { height: 180px; }
      .s-card p { font-size: 14px; padding: 12px; }
      h1 { font-size: 22px; }
      .section-title { font-size: 20px; }
      .btn, .load-btn { padding: 14px 28px; font-size: 15px; }
      .center-play-button { width: 60px; height: 60px; }
      .center-play-button i { font-size: 26px; }
    }

    @media (max-width: 480px) {
      .suggest-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
      .s-card img { height: 150px; }
      .s-card p { font-size: 13px; padding: 10px; }
      h1 { font-size: 20px; }
      .section-title { font-size: 18px; }
      .btn, .load-btn { padding: 12px 24px; font-size: 14px; width: 100%; text-align: center; }
      .center-play-button { width: 50px; height: 50px; }
      .center-play-button i { font-size: 22px; }
    }
  </style>
</head>
<body>
<%- include('partials/nav') %>
<%- include('partials/header') %>

<div class="wrap">
  <h1><i class="fa-solid fa-video" aria-hidden="true"></i> <%= data.hadding %></h1>

  <!-- Video Player -->
  <div class="video-player-container">
    <video
      id="mainVideo"
      controls
      nodownload
      preload="auto"
      playsinline
      poster="<%= data.img %>"
      aria-label="<%= data.hadding %>"
      data-playing="false">
      <source src="<%= data.play %>" type="video/mp4">
      Your browser does not support the video tag.
    </video>
    <div class="description">
      <p><i class="fa-solid fa-circle-info" aria-hidden="true"></i> <%= description %></p>
    </div>
    <div class="center-play-button" id="centerPlayButton" aria-label="Play or pause video">
      <i class="fa-solid fa-play" id="centerPlayIcon" aria-hidden="true"></i>
    </div>
  </div>

  <div class="actions">
    <a class="btn" href="<%= smartLink %>">
      <i class="fa-solid fa-download" aria-hidden="true"></i> Download Video
    </a>
  </div>
</div>

<hr style="margin:20px 0;border:0;border-top:1px solid var(--border)">

<div class="wrap">
  <h2 class="section-title"><i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i> Suggested Videos</h2>

  <div class="suggest-grid" id="suggestGrid">
    <% suggested.forEach(item => { %>
      <a href="/movie/<%= item.id %>" class="s-card">
        <div class="rating"><i class="fa-solid fa-star" aria-hidden="true"></i><%= (Math.random() * 2 + 8).toFixed(1) %></div>
        <img src="<%= item.img %>" width="300" height="400" loading="lazy" decoding="async" alt="<%= item.hadding %>">
        <p><%= item.hadding %></p>
      </a>
    <% }) %>
  </div>

  <button id="loadMore" class="load-btn" aria-live="polite">
    <span>See More</span>
    <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
  </button>

  <div class="otherWebsite">
    <h2 class="section-title" style="justify-content:center"><i class="fa-solid fa-globe" aria-hidden="true"></i> Other Website</h2>
    <a href="<%= moreWebsite %>" class="btn btn-tw"><i class="fa-solid fa-globe" aria-hidden="true"></i> P9X9.COM</a>
    <a href="<%= telegramLink %>" class="btn btn-tg"><i class="fa-brands fa-telegram" aria-hidden="true"></i> Telegram</a>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Video player play / pause
  var video = document.getElementById('mainVideo');
  var centerPlayButton = document.getElementById('centerPlayButton');
  var centerPlayIcon = document.getElementById('centerPlayIcon');

  function toggleVideoPlayback() {
    if (video.paused) {
      video.play();
      video.setAttribute('data-playing', 'true');
      centerPlayIcon.className = 'fa-solid fa-pause';
    } else {
      video.pause();
      video.setAttribute('data-playing', 'false');
      centerPlayIcon.className = 'fa-solid fa-play';
    }
  }

  centerPlayButton.addEventListener('click', function(e) {
    e.stopPropagation();
    toggleVideoPlayback();
  });

  video.addEventListener('click', function(e) {
    e.stopPropagation();
    toggleVideoPlayback();
  });

  video.addEventListener('play', function() {
    video.setAttribute('data-playing', 'true');
    centerPlayIcon.className = 'fa-solid fa-pause';
  });

  video.addEventListener('pause', function() {
    video.setAttribute('data-playing', 'false');
    centerPlayIcon.className = 'fa-solid fa-play';
  });

  video.addEventListener('ended', function() {
    video.setAttribute('data-playing', 'false');
    centerPlayIcon.className = 'fa-solid fa-play';
  });
});

// ===== Load more suggestions =====
var skip = 8;
var excludeId = "<%= data.id %>";
var grid = document.getElementById("suggestGrid");
var btn = document.getElementById("loadMore");

btn.addEventListener("click", async () => {
  btn.innerHTML = '<span>Loading...</span><i class="fa-solid fa-spinner fa-spin"></i>';
  btn.disabled = true;

  try {
    var res = await fetch('/api/suggested?excludeId=' + excludeId + '&skip=' + skip);
    var data = await res.json();

    if (!data.length) {
      btn.innerHTML = '<span>No more videos</span>';
      btn.disabled = true;
      return;
    }

    data.forEach(function (item) {
      var rating = (Math.random() * 2 + 8).toFixed(1);
      var a = document.createElement("a");
      a.href = '/movie/' + item.id;
      a.className = 's-card';
      a.innerHTML =
        '<div class="rating"><i class="fa-solid fa-star" aria-hidden="true"></i>' + rating + '</div>' +
        '<img src="' + item.img + '" loading="lazy" decoding="async" alt="' + item.hadding + '">' +
        '<p>' + item.hadding + '</p>';
      grid.appendChild(a);
    });

    skip += 8;
    btn.innerHTML = '<span>See More</span><i class="fa-solid fa-chevron-down"></i>';
    btn.disabled = false;
  } catch (error) {
    console.error("Error loading suggestions:", error);
    btn.innerHTML = '<span>Error loading. Try again</span>';
    btn.disabled = false;
  }
});
</script>

<%- include("Ads") %>
</body>
</html>