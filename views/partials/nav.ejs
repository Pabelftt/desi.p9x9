<style>
  /* ============================== THEME VARIABLES ============================== */
  :root,
  html[data-theme="dark"] {
    --bg: #07080d;
    --bg-soft: #0d0f16;
    --surface: #14161f;
    --surface-2: #1c1f2b;
    --text: #eef0f7;
    --text-2: #a6a9bf;
    --border: rgba(255, 255, 255, 0.08);
    --nav-bg: rgba(10, 12, 18, 0.92);
    --accent: #4da3ff;
    --accent-2: #ff4da3;
    --gradient: linear-gradient(135deg, #4da3ff 0%, #ff4da3 100%);
    --shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
    --input-bg: rgba(255, 255, 255, 0.06);
    --card-grad: linear-gradient(145deg, #1c1f2b 0%, #10121a 100%);
    --footer-bg: rgba(10, 12, 18, 0.9);
  }

  html[data-theme="light"] {
    --bg: #f3f5f9;
    --bg-soft: #ffffff;
    --surface: #ffffff;
    --surface-2: #eef0f5;
    --text: #16182a;
    --text-2: #5b5e74;
    --border: rgba(20, 22, 40, 0.12);
    --nav-bg: rgba(255, 255, 255, 0.92);
    --accent: #2f7dff;
    --accent-2: #e2388c;
    --gradient: linear-gradient(135deg, #2f7dff 0%, #e2388c 100%);
    --shadow: 0 8px 24px rgba(30, 40, 90, 0.14);
    --input-bg: rgba(0, 0, 0, 0.05);
    --card-grad: linear-gradient(145deg, #ffffff 0%, #f0f2f8 100%);
    --footer-bg: rgba(255, 255, 255, 0.92);
  }

  /* ============================== NAVBAR ============================== */
  nav {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
    z-index: 1000;
    background: var(--nav-bg);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border);
    box-shadow: var(--shadow);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    padding: 12px 22px;
  }

  nav .logo {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 9px;
    font-family: inherit;
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: 0.5px;
    background: var(--gradient);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    text-decoration: none;
    white-space: nowrap;
  }

  nav .logo img {
    width: 34px;
    height: 34px;
    border-radius: 9px;
    object-fit: contain;
    box-shadow: 0 4px 12px var(--shadow);
    -webkit-text-fill-color: initial;
    flex: 0 0 34px;
  }

  @media (max-width: 900px) {
    nav .logo img { width: 30px; height: 30px; flex-basis: 30px; }
  }

  nav .search-form {
    flex: 1;
    min-width: 200px;
    max-width: 460px;
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--input-bg);
    border: 1px solid var(--border);
    border-radius: 40px;
    padding: 4px 6px 4px 16px;
    transition: border-color 0.3s, box-shadow 0.3s;
  }

  nav .search-form:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(77, 163, 255, 0.18);
  }

  nav .search-form .fa-magnifying-glass {
    color: var(--text-2);
    font-size: 14px;
  }

  nav .search-form input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: none;
    outline: none;
    color: var(--text);
    font-size: 15px;
    padding: 7px 4px;
  }

  nav .search-form input::placeholder {
    color: var(--text-2);
  }

  nav .search-form button {
    background: var(--gradient);
    color: #fff;
    border: none;
    border-radius: 32px;
    min-width: 42px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: filter 0.3s, transform 0.3s;
  }

  nav .search-form button:hover {
    filter: brightness(1.12);
    transform: scale(1.04);
  }

  nav ul {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  nav ul li a {
    color: var(--text-2);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 13px;
    border-radius: 12px;
    transition: color 0.3s, background 0.3s;
  }

  nav ul li a:hover {
    color: var(--accent);
    background: var(--input-bg);
  }

  nav .theme-toggle {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--input-bg);
    color: var(--text);
    font-size: 17px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s, box-shadow 0.3s, color 0.3s;
  }

  nav .theme-toggle:hover {
    transform: rotate(18deg) scale(1.08);
    color: var(--accent);
    box-shadow: 0 0 0 4px var(--input-bg);
  }

  nav .menu-toggle {
    display: none;
    font-size: 1.4rem;
    border: none;
    background: transparent;
    color: var(--text);
    cursor: pointer;
    padding: 6px;
  }

  @media (max-width: 900px) {
    nav { padding: 12px 16px; }
    nav .logo { font-size: 1.3rem; }
    nav .logo { margin-right: auto; }
    nav .search-form { order: 4; flex: 0 1 100%; width: 100%; max-width: none; min-width: 0; margin-left: 0; }
    nav .menu-toggle { display: flex; order: 2; flex: 0 0 auto; }
    nav ul {
      position: fixed;
      top: 0;
      right: 0;
      width: min(280px, 100vw);
      height: 100vh;
      height: 100dvh;
      box-sizing: border-box;
      flex-direction: column;
      align-items: stretch;
      gap: 6px;
      padding: 66px 16px 20px;
      background: var(--nav-bg);
      backdrop-filter: blur(16px);
      border-left: 1px solid var(--border);
      box-shadow: -8px 0 30px var(--shadow);
      transform: translateX(100%);
      transition: transform 0.35s ease;
      z-index: 999;
    }
    nav ul.active { transform: translateX(0); }
    nav ul li a { padding: 13px 16px; font-size: 1.05rem; }
    nav .theme-toggle { order: 3; flex: 0 0 42px; margin-left: 0; }
  }

  @media (max-width: 360px) {
    nav { gap: 10px; padding: 10px 12px; }
    nav .logo { gap: 6px; font-size: 1.1rem; letter-spacing: 0; }
    nav .logo img { width: 28px; height: 28px; flex-basis: 28px; }
    nav .menu-toggle { padding: 4px; font-size: 1.2rem; }
    nav .theme-toggle { width: 38px; height: 38px; flex-basis: 38px; }
  }
</style>

<!-- ====== NAVBAR ====== -->
<nav aria-label="Main navigation">
  <a href="/" class="logo" aria-label="Desi.P9X9 home">
    <img src="/favicon.png" width="34" height="34" alt="" decoding="async">
    Desi.P9X9
  </a>

  <form class="search-form" action="/" method="GET" role="search">
    <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
    <input
      type="search"
      name="q"
      placeholder="Search videos..."
      aria-label="Search videos"
      value="<%= typeof query !== 'undefined' ? query : '' %>"
      autocomplete="off"
    />
    <button type="submit" aria-label="Search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
  </form>

  <button class="menu-toggle" id="menuToggle" aria-label="Menu" aria-controls="navLinks" aria-expanded="false"><i class="fa-solid fa-bars" aria-hidden="true"></i></button>

  <ul id="navLinks">
    <li><a href="/"><i class="fa-solid fa-house" aria-hidden="true"></i> Home</a></li>
    <li><a href="/l"><i class="fa-solid fa-film" aria-hidden="true"></i> Videos</a></li>
    <li><a href="https://bd.p9x9.com/pages/about"><i class="fa-solid fa-circle-info" aria-hidden="true"></i> About</a></li>
    <li><a href="https://bd.p9x9.com/pages/contact"><i class="fa-solid fa-envelope" aria-hidden="true"></i> Contact</a></li>
  </ul>

  <button class="theme-toggle" id="themeToggle" aria-label="Toggle dark or light theme" title="Toggle theme">
    <i class="fa-solid fa-moon" aria-hidden="true"></i>
  </button>
</nav>

<script>
(function () {
  // ===== Responsive menu =====
  var menuToggle = document.getElementById('menuToggle');
  var navLinks = document.getElementById('navLinks');
  menuToggle.addEventListener('click', function () {
    var open = navLinks.classList.toggle('active');
    menuToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
  navLinks.querySelectorAll('a').forEach(function (a) {
    a.addEventListener('click', function () {
      navLinks.classList.remove('active');
      menuToggle.setAttribute('aria-expanded', 'false');
    });
  });

  // ===== Theme toggle (dark / light) =====
  var root = document.documentElement;
  var stored = localStorage.getItem('desi-theme');
  if (stored) root.setAttribute('data-theme', stored);

  var themeBtn = document.getElementById('themeToggle');
  function syncIcon() {
    var isLight = root.getAttribute('data-theme') === 'light';
    themeBtn.innerHTML = isLight
      ? '<i class="fa-solid fa-sun"></i>'
      : '<i class="fa-solid fa-moon"></i>';
  }
  syncIcon();
  themeBtn.addEventListener('click', function () {
    var next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
    root.setAttribute('data-theme', next);
    localStorage.setItem('desi-theme', next);
    syncIcon();
  });
})();
</script>