<!DOCTYPE html>
<html lang="bn" data-theme="dark">
<head>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-YFCKZB39ES"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-YFCKZB39ES');
  </script>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= hadding %></title>
  <meta name="description" content="<%= description %>">
  <meta name="robots" content="index, follow">
  <meta name="keywords" content="<%= keywords %>" />
  <meta name="theme-color" content="#07080d">

  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="icon" type="image/png" sizes="128x128" href="/favicon.png">
  <link rel="canonical" href="<%= url %>" />

  <!-- Preconnects -->
  <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
  <link rel="preconnect" href="https://i.postimg.cc">
  <!-- OG -->
  <meta property="og:title" content="<%= hadding %>">
  <meta property="og:description" content="<%= description %>">
  <meta property="og:image" content="<%= img %>">
  <meta property="og:url" content="<%= url %>">
  <meta property="og:type" content="website">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= hadding %>">
  <meta name="twitter:description" content="<%= description %>">
  <meta name="twitter:image" content="<%= img %>">

  <!-- Font Awesome (non-blocking) -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css"></noscript>

  <!-- Prevent theme flash -->
  <script>
    document.documentElement.setAttribute('data-theme', localStorage.getItem('desi-theme') || 'dark');
  </script>

  <style>
    /* ====== Base ====== */
    * { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      max-width: 100%;
      overflow-x: hidden;
    }

    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      min-height: 100vh;
      transition: background 0.35s, color 0.35s;
    }

    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background:
        radial-gradient(circle at 20% 30%, rgba(77, 163, 255, 0.06) 0%, transparent 50%),
        radial-gradient(circle at 80% 70%, rgba(255, 77, 164, 0.05) 0%, transparent 50%),
        radial-gradient(circle at 40% 80%, rgba(255, 184, 77, 0.05) 0%, transparent 50%);
      z-index: -1;
      pointer-events: none;
    }

    /* ====== Search result ====== */
    .search-box {
      max-width: 1100px;
      margin: 34px auto 0;
      padding: 0 20px;
    }

    .search-result {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 16px 22px;
      font-size: 19px;
      font-weight: 700;
      color: var(--text);
      background: linear-gradient(90deg, var(--surface) 0%, var(--surface-2) 100%);
      border-radius: 16px;
      border-left: 5px solid var(--accent);
      box-shadow: var(--shadow);
      overflow: hidden;
      position: relative;
    }

    .search-result i {
      color: var(--accent);
      font-size: 22px;
    }

    .search-result::after {
      content: '';
      position: absolute;
      top: 0; left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.06), transparent);
      animation: searchShine 3s infinite;
    }

    @keyframes searchShine {
      0% { transform: translateX(-100%); }
      100% { transform: translateX(100%); }
    }

    /* ====== Latest additions ====== */
    .latest {
      max-width: 1400px;
      margin: 34px auto 0;
      padding: 0 20px;
    }

    .latest-title {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: var(--text-2);
      margin-bottom: 14px;
    }

    .latest-title i { color: var(--accent-2); }

    .latest-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, 320px);
      justify-content: center;
      gap: 14px;
    }

    .latest-grid a {
      display: flex;
      flex-direction: column;
      width: 320px;
      overflow: hidden;
      background: var(--card-grad);
      border: 1px solid var(--border);
      border-radius: 16px;
      color: var(--text);
      font-weight: 600;
      font-size: 15px;
      text-decoration: none;
      transition: transform 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.35s, border-color 0.35s;
    }

    .latest-grid a img {
      display: block;
      width: 100%;
      height: auto;
      border-bottom: 1px solid var(--border);
    }

    .latest-card-title {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 0 16px 16px;
    }

    .latest-grid a:hover {
      transform: translateY(-4px);
      border-color: var(--accent);
      box-shadow: 0 14px 30px var(--shadow);
    }

    .latest-grid a i {
      background: var(--gradient);
      color: #fff;
      width: 36px;
      height: 36px;
      flex: 0 0 36px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 15px;
    }

    /* ====== Movie grid ====== */
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, 300px);
      justify-content: center;
      gap: 24px;
      padding: 40px 30px 10px;
      margin: 0 auto;
    }

    .infinite-load {
      width: min(340px, calc(100% - 32px));
      margin: 22px auto 0;
      text-align: center;
    }

    .load-btn {
      display: flex;
      width: 100%;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 14px 20px;
      border: 0;
      border-radius: 12px;
      background: linear-gradient(135deg, #1a6bff 0%, #123a8f 100%);
      box-shadow: 0 8px 22px rgba(26, 107, 255, 0.25);
      color: #fff;
      font: inherit;
      font-weight: 700;
      cursor: pointer;
    }

    .load-btn:hover { filter: brightness(1.1); }
    .load-btn:disabled { cursor: wait; opacity: 0.7; }
    .load-btn[hidden] { display: none; }
    #movieLoadStatus { min-height: 1.5em; color: var(--text-2); }

    .card {
      position: relative;
      overflow: hidden;
      border-radius: 18px;
      background: var(--card-grad);
      text-decoration: none;
      color: var(--text);
      transition: transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.5s;
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
      display: flex;
      flex-direction: column;
    }

    .card::before {
      content: '';
      position: absolute;
      top: 0; left: 0;
      width: 100%; height: 100%;
      background: linear-gradient(135deg, rgba(77, 163, 255, 0.12) 0%, rgba(255, 77, 164, 0.12) 100%);
      opacity: 0;
      transition: opacity 0.4s;
      z-index: 1;
      pointer-events: none;
    }

    .card img {
      width: 100%;
      height: auto;
      display: block;
      filter: brightness(0.92);
      transition: filter 0.6s;
      border-bottom: 1px solid var(--border);
    }

    .card h3 {
      position: relative;
      z-index: 2;
      padding: 18px 15px;
      font-size: 17px;
      font-weight: 700;
      color: var(--text);
      flex-grow: 1;
      display: flex;
      align-items: center;
      line-height: 1.4;
      transition: color 0.3s, transform 0.3s;
    }

    .card::after {
      content: '';
      position: absolute;
      bottom: 0; left: 0;
      width: 100%; height: 5px;
      background: var(--gradient);
      transform: scaleX(0);
      transition: transform 0.5s;
      z-index: 3;
    }

    .card:hover {
      transform: translateY(-12px);
      box-shadow: 0 24px 45px var(--shadow), 0 0 30px rgba(77, 163, 255, 0.25);
      border-color: rgba(77, 163, 255, 0.5);
    }

    .card:hover::before { opacity: 1; }
    .card:hover img { filter: brightness(1.1); }
    .card:hover h3 { color: var(--accent); transform: translateY(-5px); }
    .card:hover::after { transform: scaleX(1); }

    /* Rating badge */
    .card .rating {
      position: absolute;
      top: 13px;
      right: 13px;
      background: linear-gradient(135deg, #c2185b, #8e1045);
      color: #fff;
      font-weight: 800;
      font-size: 13px;
      padding: 6px 11px;
      border-radius: 10px;
      z-index: 3;
      box-shadow: 0 5px 14px rgba(0, 0, 0, 0.45);
      display: flex;
      align-items: center;
      gap: 5px;
    }

    .card .rating i { color: gold; font-size: 11px; }

    /* ====== Footer ====== */
    footer {
      text-align: center;
      padding: 34px 20px;
      color: var(--text-2);
      font-size: 14px;
      border-top: 1px solid var(--border);
      margin-top: 50px;
      background: var(--footer-bg);
    }

    footer i { color: var(--accent-2); margin: 0 4px; }

    /* ====== Responsive ====== */
    @media (max-width: 1024px) {
      .grid { gap: 20px; padding: 32px 20px 8px; }
    }

    @media (max-width: 768px) {
      .grid { grid-template-columns: 300px; gap: 16px; padding: 26px 10px 6px; }
      .card h3 { font-size: 15px; padding: 14px 12px; }
      .search-result { font-size: 16px; padding: 14px 18px; }
      .latest { padding: 0 16px; margin-top: 26px; }
    }

    @media (max-width: 480px) {
      .grid { grid-template-columns: 300px; gap: 12px; padding: 22px 10px 4px; }
      .card h3 { font-size: 13px; padding: 10px 8px; }
      .card .rating { font-size: 11px; padding: 4px 7px; top: 8px; right: 8px; }
      .latest-grid { grid-template-columns: 320px; }
      .latest-grid a { font-size: 14px; }
      .search-result { font-size: 15px; }
    }
  </style>
</head>
<body>

<%- include('partials/nav') %>
<%- include('partials/header') %>

  <% if (query) { %>
  <div class="search-box">
    <div class="search-result" role="status">
      <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
      <span>Search result for: "<%= query %>"</span>
    </div>
  </div>
  <% } %>

<div class="latest">
  <div class="latest-title"><i class="fa-solid fa-fire" aria-hidden="true"></i> Latest Additions</div>
  <div class="latest-grid">
    <% latest.forEach(item => { %>
      <a class="latest-card" href="/movie/<%= item.id %>">
        <img src="<%= item.img %>" loading="lazy" decoding="async" alt="<%= item.hadding %>">
        <span class="latest-card-title"><i class="fa-solid fa-play" aria-hidden="true"></i> <%= item.hadding %></span>
      </a>
    <% }) %>
  </div>
</div>

<div
  class="grid"
  id="movieGrid"
  data-query="<%= query %>"
  data-skip="<%= data.length %>"
  data-has-more="<%= hasMore %>">
  <% data.forEach((movie, idx) => { %>
    <a href="/movie/<%= movie.id %>" class="card">
      <div class="rating"><i class="fa-solid fa-star" aria-hidden="true"></i><%= (Math.random() * 2 + 8).toFixed(1) %></div>
      <img
        src="<%= movie.img %>"
        loading="<%= idx === 0 ? 'eager' : 'lazy' %>"
        <% if (idx === 0) { %>fetchpriority="high"<% } %>
        decoding="async"
        alt="<%= movie.hadding %>">
      <h3><%= movie.hadding %></h3>
    </a>
  <% }) %>
</div>

<div class="infinite-load">
  <button id="loadMoreMovies" class="load-btn" type="button" <%= hasMore ? '' : 'hidden' %>>
    <span>Load more videos</span>
    <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
  </button>
  <p id="movieLoadStatus" role="status" aria-live="polite"></p>
</div>

<footer>
  <i class="fa-solid fa-copyright" aria-hidden="true"></i> 2026 Movie Collection. All rights reserved.
</footer>

<script>
(function() {
  var grid = document.getElementById('movieGrid');
  var button = document.getElementById('loadMoreMovies');
  var status = document.getElementById('movieLoadStatus');
  var skip = Number(grid.dataset.skip);
  var query = grid.dataset.query;
  var hasMore = grid.dataset.hasMore === 'true';
  var loading = false;
  var observer;

  function appendMovie(movie) {
    var card = document.createElement('a');
    card.href = '/movie/' + encodeURIComponent(movie.id);
    card.className = 'card';

    var rating = document.createElement('div');
    rating.className = 'rating';
    rating.innerHTML = '<i class="fa-solid fa-star" aria-hidden="true"></i>' + (Math.random() * 2 + 8).toFixed(1);

    var image = document.createElement('img');
    image.src = movie.img;
    image.loading = 'lazy';
    image.decoding = 'async';
    image.alt = movie.hadding;

    var title = document.createElement('h3');
    title.textContent = movie.hadding;
    card.append(rating, image, title);
    grid.appendChild(card);
  }

  async function loadNextPage() {
    if (loading || !hasMore) return;
    loading = true;
    button.disabled = true;
    button.innerHTML = '<span>Loading...</span><i class="fa-solid fa-spinner fa-spin" aria-hidden="true"></i>';
    status.textContent = '';

    try {
      var params = new URLSearchParams({ skip: String(skip) });
      if (query) params.set('q', query);
      var response = await fetch('/api/movies?' + params.toString());
      if (!response.ok) throw new Error('Movie request failed: ' + response.status);
      var result = await response.json();

      result.movies.forEach(appendMovie);
      skip += result.movies.length;
      hasMore = result.hasMore;
      grid.dataset.skip = String(skip);
      grid.dataset.hasMore = String(hasMore);
      button.hidden = !hasMore;
      button.innerHTML = '<span>Load more videos</span><i class="fa-solid fa-chevron-down" aria-hidden="true"></i>';
    } catch (error) {
      console.error('Error loading videos:', error);
      button.innerHTML = '<span>Could not load. Try again</span>';
      status.textContent = 'Videos could not be loaded. Please try again.';
      if (observer) observer.unobserve(button);
    } finally {
      loading = false;
      button.disabled = false;
    }
  }

  button.addEventListener('click', loadNextPage);
  if ('IntersectionObserver' in window && hasMore) {
    observer = new IntersectionObserver(function(entries) {
      if (entries.some(function(entry) { return entry.isIntersecting; })) loadNextPage();
    }, { rootMargin: '600px 0px' });
    observer.observe(button);
  }
})();
</script>

<% if (socialBarScriptUrl) { %>
<script data-cfasync="false" src="<%= socialBarScriptUrl %>"></script>
<% } %>
</body>
</html>